import React, { useRef, useState } from "react";
import { motion } from "framer-motion";

/** Map a horizontal scroll position to a 0-based page index across 2 pages. */
export function pageFromScroll(scrollLeft: number, scrollWidth: number, clientWidth: number): 0 | 1 {
  const maxScroll = Math.max(0, scrollWidth - clientWidth);
  if (maxScroll === 0) return 0;
  return scrollLeft > maxScroll / 2 ? 1 : 0;
}

const SKY = "#58ABFF";
const PILL_BG = "#FFFFFF"; // pure white; page bg is #F4F4F4 so add a hairline + soft shadow for definition

export type StatPill = { label: string; v: number; Ico: React.ComponentType<{ c?: string }> };

export function StatCarousel({ stats }: { stats: StatPill[] }) {
  const ref = useRef<HTMLDivElement>(null);
  const [page, setPage] = useState<0 | 1>(0);

  const onScroll = () => {
    const el = ref.current;
    if (!el) return;
    setPage(pageFromScroll(el.scrollLeft, el.scrollWidth, el.clientWidth));
  };

  return (
    <div style={{ padding: "16px 18px 0" }}>
      <div
        ref={ref}
        onScroll={onScroll}
        style={{
          display: "flex",
          gap: 12,
          overflowX: "auto",
          scrollSnapType: "x mandatory",
          WebkitOverflowScrolling: "touch",
          scrollbarWidth: "none",
        }}
      >
        {stats.map(({ label, v, Ico }) => (
          <motion.div
            key={label}
            whileHover={{ y: -2, transition: { duration: 0.18, ease: [0.34, 1.56, 0.64, 1] } }}
            whileTap={{ scale: 0.98 }}
            style={{
              flex: "0 0 calc(50% - 6px)", // 2 pills per view (gap 12 -> 6 each)
              scrollSnapAlign: "start",
              background: PILL_BG,
              borderRadius: 22,
              padding: "16px 16px",
              minHeight: 100,
              display: "flex",
              flexDirection: "column",
              justifyContent: "flex-start",
              boxSizing: "border-box",
              border: "1px solid rgba(4,13,109,0.06)",
              boxShadow: "0 4px 14px rgba(4,13,109,0.06)",
            }}
          >
            <div style={{ marginBottom: 10 }}><Ico c={SKY} /></div>
            <div style={{ fontWeight: 700, fontSize: 9, color: SKY, letterSpacing: "0.06em", textTransform: "uppercase", marginBottom: 6, whiteSpace: "nowrap" }}>{label}</div>
            <div style={{ fontWeight: 800, fontSize: 30, color: SKY, letterSpacing: "-0.03em", lineHeight: 1, fontVariantNumeric: "tabular-nums" }}>{v}</div>
          </motion.div>
        ))}
      </div>

      {/* 2 page dots */}
      <div style={{ display: "flex", justifyContent: "center", gap: 7, marginTop: 12 }}>
        {[0, 1].map((i) => (
          <span
            key={i}
            style={{
              width: page === i ? 18 : 6,
              height: 6,
              borderRadius: 999,
              background: page === i ? SKY : "rgba(88,171,255,0.3)",
              transition: "width 0.3s cubic-bezier(0.34,1.56,0.64,1), background 0.3s ease",
            }}
          />
        ))}
      </div>
    </div>
  );
}
