              <div style={{ fontWeight: 500, fontSize: 13.5, color: BLUE, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', marginTop: 2 }}>{dest || `tenant's ${channel}`}</div>
            </div>
          </div>
        </div>

        {/* CTA */}
        <div style={{ flexShrink: 0, padding: '12px 0 calc(env(safe-area-inset-bottom, 0px) + 92px)', display: 'flex', justifyContent: 'center' }}>
          <ConfirmButton
            onConfirm={onSend}
            confirmed={sending}
            disabled={!ready || sending}
            color={BLUE}
            onSolidColor={NAVY}
            style={{ minWidth: 220, padding: '10px 26px', fontSize: 13 }}
          >
            send bill
          </ConfirmButton>
        </div>
      </div>
    </div>
