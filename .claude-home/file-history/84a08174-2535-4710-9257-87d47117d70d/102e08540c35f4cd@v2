// client/src/lib/motion.ts
// Shared motion language. The overshoot easing is the terminal's signature
// "bounce/pop-in" feel (cubic-bezier(0.34,1.56,0.64,1)).
export const OVERSHOOT = [0.34, 1.56, 0.64, 1] as const;
export const POP_DURATION = 0.42;
export const STAGGER_STEP = 0.06;

/** Framer Motion transition for a pop-in, staggered by sibling index. */
export function popInTransition(index = 0) {
  return { duration: POP_DURATION, ease: OVERSHOOT, delay: index * STAGGER_STEP };
}

/** True when the user has asked for reduced motion. SSR/test-safe. */
export function prefersReducedMotion(): boolean {
  if (typeof window === "undefined" || typeof window.matchMedia !== "function") return false;
  return window.matchMedia("(prefers-reduced-motion: reduce)").matches === true;
}
```

