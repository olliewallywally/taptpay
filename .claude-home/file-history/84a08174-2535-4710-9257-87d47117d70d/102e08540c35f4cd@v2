```tsx
import { AnimatePresence, motion } from "framer-motion";
import { useLocation } from "wouter";
import { isVTPending } from "@/lib/view-transition";
import { OVERSHOOT, prefersReducedMotion } from "@/lib/motion";

export function PageTransition({ children }: { children: React.ReactNode }) {
  const [location] = useLocation();

  // When the View Transitions API is handling the animation (hero morph between
  // property pages), bypass Framer Motion entirely so they don't fight.
  if (isVTPending()) {
    return <>{children}</>;
  }

  const reduced = prefersReducedMotion();

  return (
    <AnimatePresence mode="wait" initial={false}>
      <motion.div
        key={location}
        initial={reduced ? { opacity: 0 } : { opacity: 0, y: 16, scale: 0.972 }}
        animate={reduced ? { opacity: 1 } : { opacity: 1, y: 0, scale: 1 }}
        exit={reduced
          ? { opacity: 0, transition: { duration: 0.14 } }
          : { opacity: 0, scale: 0.984, y: -10, transition: { duration: 0.18, ease: "easeIn" } }}
        transition={reduced
          ? { duration: 0.2, ease: "easeOut" }
          : { duration: 0.44, ease: OVERSHOOT }}
        style={{ willChange: "opacity, transform" }}
      >
        {children}
      </motion.div>
    </AnimatePresence>
  );
}
```

