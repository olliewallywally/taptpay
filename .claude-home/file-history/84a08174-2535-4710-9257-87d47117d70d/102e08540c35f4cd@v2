// client/src/lib/sound.ts
const MUTE_KEY = "taptpay.chime.muted";
let hasInteracted = false;

if (typeof window !== "undefined") {
  const mark = () => { hasInteracted = true; };
  window.addEventListener("pointerdown", mark, { once: true });
  window.addEventListener("keydown", mark, { once: true });
}

export function isChimeMuted(): boolean {
  try { return localStorage.getItem(MUTE_KEY) === "1"; } catch { return false; }
}

export function setChimeMuted(muted: boolean): void {
  try { localStorage.setItem(MUTE_KEY, muted ? "1" : "0"); } catch { /* ignore */ }
}

let audio: HTMLAudioElement | null = null;

/** Play the success chime. No-op when muted or before first user interaction. */
export function playPaymentChime(): void {
  if (typeof window === "undefined") return;
  if (isChimeMuted() || !hasInteracted) return;
  try {
    if (!audio) { audio = new Audio("/sounds/payment-success.mp3"); audio.volume = 0.5; }
    audio.currentTime = 0;
    void audio.play().catch(() => { /* autoplay blocked — ignore */ });
  } catch { /* ignore */ }
}
```

