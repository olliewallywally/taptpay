```ts
const REMINDER_COOLDOWN_MS = 5 * 60 * 1000;

/**
 * Manually send a reminder for a single invoice (the terminal "remind" button).
 * Forces reminder-flavoured copy regardless of overdue status, enforces a 5-minute
 * cooldown via lastReminderSentAt, and bumps reminderCount. Distinct from the
 * automated overdue pass (runReminderPass) and from resend (original copy).
 */
export async function sendInvoiceReminder(
  invoiceId: string,
  baseUrl: string,
  now: Date = new Date(),
): Promise<{ ok: boolean; reason?: string; retryAfterMs?: number; invoice?: any }> {
  const invoice = await storage.getInvoiceRentRequest(invoiceId);
  if (!invoice) return { ok: false, reason: "not_found" };
  if (["paid", "paid_external", "voided"].includes(invoice.status)) return { ok: false, reason: "not_payable" };

  if (invoice.lastReminderSentAt) {
    const elapsed = now.getTime() - new Date(invoice.lastReminderSentAt).getTime();
    if (elapsed < REMINDER_COOLDOWN_MS) {
      return { ok: false, reason: "cooldown", retryAfterMs: REMINDER_COOLDOWN_MS - elapsed };
    }
  }

  const delivery = await deliverInvoice(invoice, baseUrl, deliverOptsFor(invoice, true));
  if (!delivery.sent) return { ok: false, reason: delivery.reason || "send_failed" };

  const updated = await storage.updateInvoiceRentRequest(invoiceId, {
    lastReminderSentAt: now,
    reminderCount: (invoice.reminderCount ?? 0) + 1,
  });
  await storage.logTransactionEvent({
    merchantId: invoice.merchantId, tenantProfileId: invoice.tenantProfileId,
    invoiceId, eventType: "Reminder_Sent", payload: { channel: delivery.channel, manual: true },
  });
  return { ok: true, invoice: updated };
}
```

