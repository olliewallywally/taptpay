```ts
// client/src/hooks/use-payment-received-toast.ts
import { useEffect, useRef } from "react";
import { sseClient } from "@/lib/sse-client";
import { useNotifications } from "@/components/notification-system";
import { playPaymentChime } from "@/lib/sound";

/** Fires a compact "payment received" toast + chime when a transaction completes. */
export function usePaymentReceivedToast() {
  const { addNotification } = useNotifications();
  const seen = useRef<Set<string>>(new Set());

  useEffect(() => {
    const handler = (message: any) => {
      const tx = message?.transaction;
      if (!tx || tx.status !== "completed") return;
      const key = `${tx.id}:${tx.completedSplits ?? 0}`;
      if (seen.current.has(key)) return;
      seen.current.add(key);

      const cents = tx.amountReceivedCents ?? tx.amountCents ?? tx.totalCents ?? 0;
      const amount = "$" + (cents / 100).toLocaleString("en-NZ", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      addNotification({ type: "success", title: "Payment received", message: "", amount, compact: true, duration: 3500 } as any);
      playPaymentChime();
    };
    sseClient.subscribe("transaction_updated", handler);
    return () => sseClient.unsubscribe("transaction_updated", handler);
  }, [addNotification]);
}
```

> `tx.amountReceivedCents`/`amountCents`/`totalCents`: use whichever the transaction payload actually carries — inspect a real `transaction_updated` payload (the terminal logs `SSE message received:`); keep the `??` chain so it degrades gracefully.

