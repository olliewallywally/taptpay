<script>
  for (const stage of document.querySelectorAll(".stage")) {
    const range = stage.querySelector('input[type="range"]');
    range.addEventListener("input", () => stage.style.setProperty("--wipe", range.value));
  }
  for (const head of document.querySelectorAll(".plate-head")) {
    const stage = head.parentElement.querySelector(".stage");
    for (const btn of head.querySelectorAll(".mode")) {
      btn.addEventListener("click", () => {
        stage.dataset.mode = btn.dataset.mode;
        for (const other of head.querySelectorAll(".mode")) {
          const on = other === btn;
          other.classList.toggle("on", on);
          other.setAttribute("aria-pressed", String(on));
        }
      });
    }
