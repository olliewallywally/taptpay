  ["Trades", "Settings", "dt--trades-settings", `${MINE}/app--dt--trades-settings.png`, "/settings",
    "shot-trades-settings.mjs throws on its own strict-mode locator, so this plate is a direct capture of the logical canvas."],
];

const cropToDataUri = (file) => {
  const png = PNG.sync.read(readFileSync(file));
  /* The direct capture is already exactly the canvas — nothing to crop. */
  if (png.width <= CROP.w + 4) return `data:image/png;base64,${readFileSync(file).toString("base64")}`;
  const out = new PNG({ width: CROP.w, height: CROP.h });
  PNG.bitblt(png, out, CROP.x, CROP.y, CROP.w, CROP.h, 0, 0);
  return `data:image/png;base64,${PNG.sync.write(out).toString("base64")}`;
};

const asDataUri = (file) => `data:image/png;base64,${readFileSync(file).toString("base64")}`;

const rows = [];
for (const [vertical, screen, design, appShot, route, caveat] of PAIRS) {
  const designFile = `${DESIGN_DIR}/${design}.png`;
  if (!existsSync(designFile)) throw new Error(`missing design ${designFile}`);
  if (!existsSync(appShot)) throw new Error(`missing app shot ${appShot}`);
  rows.push({ vertical, screen, route, caveat, design: asDataUri(designFile), app: cropToDataUri(appShot) });
  console.log(`paired ${vertical}/${screen}`);
}

