import { chromium } from '/home/runner/workspace/node_modules/playwright/index.mjs';

const OUT = '/tmp/claude-1000/-home-runner-workspace/48ba60f3-59cf-44b6-bbb6-81892778133a/scratchpad';
const BASE = 'http://localhost:5000';
const CHROME = '/nix/store/zi4f80l169xlmivz8vja8wlphq74qqk0-chromium-125.0.6422.141/bin/chromium';

const browser = await chromium.launch({ executablePath: CHROME });
const page = await browser.newPage({ viewport: { width: 390, height: 844 } });
page.on('console', m => { if (m.type() === 'error') console.log('[err]', m.text()); });
page.on('pageerror', e => console.log('[pageerror]', e.message));

// quote_8000 is seeded status 'sent' → full 3-step flow
await page.goto(`${BASE}/#/trades/quote/quote_8000`, { waitUntil: 'networkidle' });
await page.waitForTimeout(1500);
await page.screenshot({ path: `${OUT}/quote-step1.png` });

// Step 1 → 2: click "view quote"
const viewBtn = page.getByRole('button', { name: /view quote/i });
console.log('view button count:', await viewBtn.count());
if (await viewBtn.count()) {
  await viewBtn.first().click();
  await page.waitForTimeout(900);
  await page.screenshot({ path: `${OUT}/quote-step2.png` });
}

// Step 2 → 3: click "confirm"
const confirmBtn = page.getByRole('button', { name: /^confirm$/i });
console.log('confirm button count:', await confirmBtn.count());
if (await confirmBtn.count()) {
  await confirmBtn.first().click();
  await page.waitForTimeout(2000);
  await page.screenshot({ path: `${OUT}/quote-step3.png` });
}
console.log('final url:', page.url());

// Revisit an already-accepted quote → should jump to payment (step 3)
await page.goto(`${BASE}/#/trades/quote/quote_8001`, { waitUntil: 'networkidle' });
await page.waitForTimeout(1800);
await page.screenshot({ path: `${OUT}/quote-accepted-revisit.png` });

await browser.close();
