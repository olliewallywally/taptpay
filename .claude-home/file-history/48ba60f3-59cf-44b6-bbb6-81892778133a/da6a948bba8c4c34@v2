const tokens = await page.evaluate(async () => {
  const found = { property: null, trades: null };
  for (let i = 5000; i < 5120 && !found.property; i++) {
    try { const r = await fetch(`/api/checkout/resolve/inv_${i}`); if (r.ok) { const j = await r.json(); if (!j.alreadyPaid) found.property = `inv_${i}`; } } catch {}
  }
  for (let i = 7000; i < 7120 && !found.trades; i++) {
    try { const r = await fetch(`/api/checkout/resolve/job_${i}`); if (r.ok) { const j = await r.json(); if (!j.alreadyPaid) found.trades = `job_${i}`; } } catch {}
  }
  return found;
});
console.log('tokens:', JSON.stringify(tokens));

if (tokens.property) {
  await page.goto(`${BASE}/#/r/${tokens.property}`, { waitUntil: 'networkidle' });
  await page.waitForTimeout(1200);
  await page.screenshot({ path: `${OUT}/property.png` });
