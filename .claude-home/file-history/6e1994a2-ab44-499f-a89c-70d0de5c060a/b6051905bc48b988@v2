const browser = await chromium.launch({ executablePath: CHROMIUM, args: ['--no-sandbox'] });
const ctx = await browser.newContext({ viewport: { width: 430, height: 900 } });

// Install capture BEFORE any app code runs — mirrors what the runtime-error-plugin hooks.
await ctx.addInitScript(() => {
  window.__caught = [];
  window.addEventListener('error', (e) => {
    window.__caught.push({ kind: 'error', message: e.message, filename: e.filename, lineno: e.lineno, stack: e.error?.stack?.split('\n').slice(0,8).join('\n') });
  });
  window.addEventListener('unhandledrejection', (e) => {
    const r = e.reason;
    window.__caught.push({ kind: 'unhandledrejection', message: (r && (r.message||String(r))) || 'unknown', stack: r?.stack?.split('\n').slice(0,8).join('\n') });
  });
});

const page = await ctx.newPage();
const pe = [], ce = [], reqFail = [];
page.on('pageerror', e => pe.push(`${e.name}: ${e.message}`));
page.on('console', m => { if (m.type()==='error') ce.push(m.text()); });
page.on('requestfailed', r => { const u=r.url(); if(!/google-analytics|replit-dev-banner|doubleclick/.test(u)) reqFail.push(`${r.failure()?.errorText} ${u}`); });

const routes = ['/', '/login', '/trades/quote/BOGUS', '/r/BOGUS'];
