  await page.goto('http://localhost:5000' + route, { waitUntil: 'networkidle', timeout: 25000 }).catch(e=>pe.push('NAV '+String(e).split('\n')[0]));
  await page.waitForTimeout(3500);
  const caught = await page.evaluate(() => window.__caught || []);
  // Detect the runtime-error-plugin overlay in DOM (shadow or element)
  const overlay = await page.evaluate(() => {
    const hit = [...document.querySelectorAll('*')].find(el => /runtime-error|plugin-runtime|error-modal|vite-error/i.test(el.tagName + ' ' + (el.id||'') + ' ' + (el.className||'')));
    return hit ? (hit.tagName + '#' + hit.id + '.' + hit.className) : null;
  });
  console.log(`\n===== ${route} =====`);
  console.log('  overlay in DOM:', overlay || '(none)');
  console.log('  window-caught errors:', caught.length ? JSON.stringify(caught, null, 1) : '(none)');
}
console.log('\n=== pageerror ===', pe.length? pe.join('\n') : '(none)');
console.log('=== console.error ===', ce.length? ce.slice(0,12).join('\n') : '(none)');
console.log('=== failed requests (non-analytics) ===', reqFail.length? [...new Set(reqFail)].slice(0,15).join('\n') : '(none)');
