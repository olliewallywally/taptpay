import { chromium } from '/home/runner/workspace/node_modules/playwright/index.mjs';
const CHROMIUM = '/nix/store/zi4f80l169xlmivz8vja8wlphq74qqk0-chromium-125.0.6422.141/bin/chromium';
const DOMAIN = process.env.REPLIT_DEV_DOMAIN;
const targets = [
  ['localhost',  'http://localhost:5000/'],
  ['replit-domain', `https://${DOMAIN}/`],
];
const browser = await chromium.launch({ executablePath: CHROMIUM, args: ['--no-sandbox'] });
for (const [name, url] of targets) {
  const ctx = await browser.newContext({ viewport: { width: 430, height: 900 }, ignoreHTTPSErrors: true });
  await ctx.addInitScript(() => {
    window.__caught = [];
