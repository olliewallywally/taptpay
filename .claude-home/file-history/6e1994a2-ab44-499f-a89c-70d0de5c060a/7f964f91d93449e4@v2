  });
  const page = await ctx.newPage();
  const conn = [];
  page.on('console', m => { const t=m.text(); if (/\[vite\]|WebSocket|hmr/i.test(t)) conn.push(`[${m.type()}] ${t}`); });
  let navOk = true;
  try { await page.goto(url, { waitUntil: 'domcontentloaded', timeout: 25000 }); }
  catch(e){ navOk=false; conn.push('NAV FAIL: '+String(e).split('\n')[0]); }
