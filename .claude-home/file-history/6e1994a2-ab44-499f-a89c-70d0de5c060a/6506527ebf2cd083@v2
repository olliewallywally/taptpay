import { chromium } from '/home/runner/workspace/node_modules/playwright/index.mjs';

const CHROMIUM = '/nix/store/zi4f80l169xlmivz8vja8wlphq74qqk0-chromium-125.0.6422.141/bin/chromium';
const OUT = '/tmp/claude-1000/-home-runner-workspace/6e1994a2-ab44-499f-a89c-70d0de5c060a/scratchpad';
const BASE = 'http://localhost:5000';

const routes = [
  ['property-invoice', '/#/r/inv_5000'],
  ['trades-invoice',   '/#/r/job_7000'],
  ['quote-sent',       '/#/trades/quote/quote_8000'],
  ['quote-accepted',   '/#/trades/quote/quote_8001'],
  ['split',            '/#/split/90222'],
];

const browser = await chromium.launch({ executablePath: CHROMIUM, args: ['--no-sandbox'] });

for (const [name, route] of routes) {
  const page = await browser.newPage({ viewport: { width: 430, height: 900 } });
  const errs = [];
  const consoleErrs = [];
  page.on('pageerror', (e) => errs.push(`${e.name}: ${e.message}\n${(e.stack||'').split('\n').slice(0,5).join('\n')}`));
  page.on('console', (m) => { if (m.type() === 'error') consoleErrs.push(m.text()); });

  let nav = null;
  try {
    await page.goto(BASE + route, { waitUntil: 'networkidle', timeout: 20000 });
  } catch (e) { nav = String(e).split('\n')[0]; }
  await page.waitForTimeout(3500);

  const bodyText = (await page.evaluate(() => document.body?.innerText || '')).replace(/\s+/g,' ').trim().slice(0, 400);
  const rootLen = await page.evaluate(() => document.getElementById('root')?.innerHTML?.length || 0);
  await page.screenshot({ path: `${OUT}/co-${name}.png` });

  console.log(`\n======== ${name}  (${route}) ========`);
  console.log('nav err:', nav || '(none)');
  console.log('#root len:', rootLen);
  console.log('BODY:', bodyText || '(EMPTY)');
  console.log('PAGE ERRORS:', errs.length ? '\n' + errs.join('\n--\n') : '(none)');
  console.log('CONSOLE ERRORS:', consoleErrs.length ? '\n' + consoleErrs.slice(0,10).join('\n') : '(none)');
  await page.close();
}

await browser.close();
console.log('\nDONE');
