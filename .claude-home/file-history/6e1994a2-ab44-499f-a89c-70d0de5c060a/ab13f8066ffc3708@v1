import { createRoot } from "react-dom/client";
import App from "./App";
import "./index.css";

function mount() {
  if ('serviceWorker' in navigator && import.meta.env.VITE_MOCK !== '1') {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js')
        .then((registration) => {
          console.log('SW registered:', registration.scope);
        })
        .catch((error) => {
          console.log('SW registration failed:', error);
        });
    });
  }

  createRoot(document.getElementById("root")!).render(<App />);
}

// Demo/visual build only: seed a fake session and mock all /api calls so the
// app renders fully populated with no backend. Tree-shaken out of normal builds
// (VITE_MOCK is a compile-time constant). See client/src/mocks/mock-api.ts.
if (import.meta.env.VITE_MOCK === '1') {
  import("./mocks/mock-api").then(({ installMockApi }) => {
    installMockApi();
    mount();
  });
} else {
  mount();
}
