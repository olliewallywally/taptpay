function Dot({ active, flip }: { active: MotionValue<number>; flip: boolean }) {
  const w = useTransform(active, [0, 1], flip ? [10, 36] : [36, 10]);
  const o = useTransform(active, [0, 1], flip ? [0.3, 1] : [1, 0.3]);
  return <motion.span className="h-1.5 rounded-full bg-current" style={{ width: w, opacity: o }} />;
}

