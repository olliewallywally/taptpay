}

/* Glowing green button effect */
.glow-green-button {
  position: relative;
  overflow: hidden;
}

.glow-green-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s;
}

.glow-green-button:hover::before {
  left: 100%;
}

.glow-green-button:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.glow-green-button:disabled:hover {
  box-shadow: none !important;
}

