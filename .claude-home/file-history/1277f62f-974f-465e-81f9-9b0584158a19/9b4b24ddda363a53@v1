@keyframes tileIn {
  from {
    opacity: 0;
    transform: translateY(16px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes reportIn {
  from {
    opacity: 0;
    transform: translateY(-14px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes glowDrift {
  0% {
    transform: translate(-28%, -42%) scale(1);
  }
  50% {
    transform: translate(30%, 22%) scale(1.18);
  }
  100% {
    transform: translate(-28%, -42%) scale(1);
  }
}

@keyframes popIn {
  0% {
    opacity: 0;
    transform: translateY(16px) scale(0.94);
  }
  55% {
    opacity: 1;
    transform: translateY(-4px) scale(1.015);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.tapt-desktop-viewport {
  position: relative;
  display: grid;
  place-items: center;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #000926;
  font-family: "Outfit", system-ui, sans-serif;
  font-weight: 400;
  line-height: normal;
  letter-spacing: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

@supports (height: 100dvh) {
  .tapt-desktop-viewport {
    height: 100dvh;
  }
}

.tapt-desktop-viewport,
.tapt-desktop-viewport *,
.tapt-desktop-viewport *::before,
.tapt-desktop-viewport *::after {
  box-sizing: border-box;
}

.tapt-desktop-viewport :where(button, input, select, textarea) {
  font-family: inherit;
  letter-spacing: normal;
}

.tapt-desktop-viewport :where(button) {
  border: 0;
  margin: 0;
  background: transparent;
  color: inherit;
}

.tapt-desktop-viewport :where(a) {
  color: inherit;
  text-decoration: none;
}

.tapt-desktop-viewport :where(input)::placeholder {
  color: rgba(94, 158, 255, 0.5);
}

.tapt-desktop-viewport :where(*) {
  scrollbar-width: none;
}

.tapt-desktop-viewport :where(*)::-webkit-scrollbar {
  width: 0;
  height: 0;
}

.tapt-desktop-frame {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #000926;
}

.tapt-desktop-viewport[data-device-class="desktop"]
  > .tapt-desktop-frame {
  width: min(1000px, 94vw, 126.0455vh);
  height: auto;
  aspect-ratio: 59 / 44;
  border-radius: 28px;
  background: #000f3f;
  box-shadow: 0 40px 120px rgba(0, 0, 0, 0.55);
}

@supports (height: 100dvh) {
  .tapt-desktop-viewport[data-device-class="desktop"]
    > .tapt-desktop-frame {
    width: min(1000px, 94vw, 126.0455dvh);
  }
}

.tapt-desktop-viewport[data-device-class="desktop"]
  > .tapt-desktop-frame::after {
  position: absolute;
  z-index: 20;
  inset: 0;
  border: 1px solid rgba(94, 158, 255, 0.18);
  border-radius: inherit;
  pointer-events: none;
  content: "";
}

.tapt-desktop-scale-stage {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #000926;
}

.tapt-desktop-viewport[data-device-class="desktop"]
  .tapt-desktop-scale-stage {
  background: #000f3f;
}

.tapt-desktop-scale-box {
  position: relative;
  flex: 0 0 auto;
  overflow: visible;
}

.tapt-desktop-scale-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 1180px;
  height: 880px;
  max-width: none !important;
  max-height: none !important;
  transform-origin: top left;
}

.tapt-desktop-canvas {
  position: relative;
  width: 1180px;
  height: 880px;
  max-width: none !important;
  max-height: none !important;
  overflow: hidden;
  background: #000f3f;
  color: #ffffff;
  font-family: "Outfit", system-ui, sans-serif;
  font-weight: 400;
  line-height: normal;
  letter-spacing: normal;
  isolation: isolate;
}

.tapt-desktop-header {
  display: flex;
  align-items: center;
  width: 100%;
  height: 66px;
  padding: 0 44px 0 46px;
}

.tapt-desktop-wordmark {
  display: flex;
  align-items: baseline;
  flex: 0 0 auto;
  color: #5e9eff;
  font-family: "Larken", Georgia, serif;
  font-size: 23px;
  font-weight: 900;
  line-height: 1;
  user-select: none;
}

.tapt-desktop-wordmark-pay {
  font-style: italic;
}

.tapt-desktop-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  min-width: 0;
  margin-left: 210px;
  padding-right: 30px;
}

.tapt-desktop-nav-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  padding: 0;
  border-radius: 9999px;
  color: #4a86f0;
  font-size: 15px;
  font-weight: 400;
  line-height: normal;
  white-space: nowrap;
  cursor: pointer;
  transition:
    color 180ms ease,
    background 180ms ease;
}

.tapt-desktop-nav-item:hover {
  color: #93baff;
}

.tapt-desktop-nav-item[aria-current="page"] {
  padding: 8px 22px;
  background: #66a9ff;
  color: #000f3f;
  font-weight: 700;
}

.tapt-desktop-nav-item:focus-visible,
.tapt-desktop-scope:focus-visible {
  outline: 2px solid #93baff;
  outline-offset: 3px;
}

.tapt-desktop-divider {
  height: 1px;
  margin: 0 2px;
  background: rgba(94, 158, 255, 0.3);
}

.tapt-desktop-main {
  position: relative;
  width: 100%;
  height: 813px;
  overflow: hidden;
}

.tapt-desktop-scope {
  position: absolute;
  z-index: 5;
  top: 26px;
  left: 52px;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 10px 20px;
  border: 1px solid rgba(94, 158, 255, 0.55) !important;
  border-radius: 9999px;
  color: #7fb2ff;
  font-size: 13.5px;
  font-weight: 400;
  line-height: normal;
  cursor: pointer;
  transition: background 180ms ease;
}

.tapt-desktop-scope:hover {
  background: rgba(94, 158, 255, 0.08);
}

.tapt-desktop-scope-chevron {
  display: block;
  flex: 0 0 auto;
}

.tapt-desktop-page-slot {
  position: relative;
  width: 100%;
  height: 100%;
}

.tapt-desktop-legacy-wrap {
  display: flex;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding-top: 18px;
}

.tapt-desktop-legacy-column {
  width: 430px;
  max-width: 430px !important;
  height: 795px;
  max-height: 795px;
  overflow-x: hidden;
  overflow-y: auto;
  border-radius: 24px 24px 0 0;
  background: #f4f4f4;
  box-shadow: 0 18px 60px rgba(0, 4, 28, 0.35);
}

@media (prefers-reduced-motion: reduce) {
  .tapt-desktop-viewport *,
  .tapt-desktop-viewport *::before,
  .tapt-desktop-viewport *::after {
    scroll-behavior: auto !important;
    animation-duration: 1ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 1ms !important;
  }
}
