// Browser E2E: dashboard quick-invoice tile → keypad → inline recipient → send
// → add client → redesigned client directory (vs tenant directory reference).
import { chromium } from '/home/runner/workspace/node_modules/playwright/index.mjs';
import jwt from '/home/runner/workspace/node_modules/jsonwebtoken/index.js';

const BASE = 'http://localhost:5000';
const SHOTS = '/tmp/claude-1000/-home-runner-workspace/c9d2317c-7d0c-4569-abe8-6b78546105d8/scratchpad/shots';
import { mkdirSync } from 'node:fs';
mkdirSync(SHOTS, { recursive: true });

const token = jwt.sign(
  { userId: 22, email: 'oliverharryleonard@gmail.com', merchantId: 22, role: 'merchant' },
  process.env.JWT_SECRET || 'dev-only-jwt-secret-not-for-production',
  { expiresIn: '1h' },
);

let pass = 0, fail = 0;
async function step(name, fn) {
  try { await fn(); pass++; console.log(`✅ ${name}`); }
  catch (e) { fail++; console.log(`❌ ${name} — ${e.constructor.name}: ${String(e.message).split('\n')[0]}`); }
}

const browser = await chromium.launch({ executablePath: '/nix/store/zi4f80l169xlmivz8vja8wlphq74qqk0-chromium-125.0.6422.141/bin/chromium' });
const page = await browser.newPage({ viewport: { width: 390, height: 844 } });
page.on('pageerror', e => console.log('   [pageerror]', e.message));
await page.addInitScript(t => localStorage.setItem('authToken', t), token);

await step('dashboard renders with quick invoice tile', async () => {
  await page.goto(`${BASE}/trades`, { waitUntil: 'networkidle' });
  await page.waitForSelector('button[aria-label="quick invoice"]', { timeout: 15000 });
  await page.screenshot({ path: `${SHOTS}/1-dashboard.png` });
});

await step('tile lands on amount keypad (no client picker)', async () => {
  await page.click('button[aria-label="quick invoice"]');
  await page.waitForSelector('.tp-kp', { timeout: 10000 });
  if (!page.url().includes('/trades/terminal')) throw new Error(`url is ${page.url()}`);
  if (await page.locator('text=choose a client').count()) throw new Error('client picker shown in quick mode');
  await page.screenshot({ path: `${SHOTS}/2-keypad.png` });
});

await step('keypad enters $45.00 and confirms', async () => {
  for (const d of ['4', '5', '0', '0']) await page.click(`.tp-kp:text-is("${d}")`);
  await page.waitForSelector('.tp-amount:has-text("45.00")', { timeout: 5000 });
  await page.click('button[aria-label="confirm"]');
});

await step('quick mode shows inline recipient form', async () => {
  await page.waitForSelector('input[placeholder="customer name"]', { timeout: 10000 });
  await page.fill('input[placeholder="customer name"]', 'Browser Test');
  await page.fill('input[placeholder="customer email"]', 'browser-test@example.com');
  await page.fill('input[placeholder="what\'s this invoice for?"]', 'browser e2e job');
  await page.screenshot({ path: `${SHOTS}/3-recipient.png` });
});

await step('send invoice → success screen', async () => {
  await page.click('button.tp-cta:has-text("send invoice")');
  await page.waitForSelector('.tp-success-check', { timeout: 15000 });
  await page.screenshot({ path: `${SHOTS}/4-success.png` });
});

await step('"add client" promotes the prospect', async () => {
  await page.click('button:has-text("add client")');
  await page.waitForSelector('text=client saved ✓', { timeout: 10000 });
  await page.screenshot({ path: `${SHOTS}/5-saved.png` });
});

await step('client directory redesign renders with new client', async () => {
  await page.goto(`${BASE}/trades/clients`, { waitUntil: 'networkidle' });
  await page.waitForSelector('input[placeholder="search clients or site"]', { timeout: 15000 });
  await page.waitForSelector('button[aria-label="Add client"]', { timeout: 5000 });
  await page.waitForSelector('text=Browser Test', { timeout: 10000 });
  await page.screenshot({ path: `${SHOTS}/6-directory.png`, fullPage: true });
});

await step('tenant directory reference shot', async () => {
  await page.goto(`${BASE}/property/tenants`, { waitUntil: 'networkidle' });
  await page.waitForSelector('input[placeholder="search tenants or address"]', { timeout: 15000 });
  await page.screenshot({ path: `${SHOTS}/7-tenant-directory-ref.png`, fullPage: true });
});

await browser.close();
console.log(`\n${pass} passed, ${fail} failed`);
process.exit(fail ? 1 : 0);
