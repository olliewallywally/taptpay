  const layers = [...document.querySelectorAll('.tp-layer')];
  const first = kps[0];
  const chain = [];
  let el = first;
  while (el && el !== document.body) {
    const cs = getComputedStyle(el);
    chain.push({
      tag: el.tagName + '.' + String(el.className).split(' ').slice(0, 2).join('.'),
      display: cs.display, opacity: cs.opacity, visibility: cs.visibility,
      transform: cs.transform === 'none' ? 'none' : cs.transform.slice(0, 60),
      animation: cs.animationName, w: el.offsetWidth, h: el.offsetHeight,
    });
    el = el.parentElement;
  }
  return {
    kpCount: kps.length,
    layerCount: layers.length,
    firstRect: first ? first.getBoundingClientRect().toJSON() : null,
    chain,
  };
});
