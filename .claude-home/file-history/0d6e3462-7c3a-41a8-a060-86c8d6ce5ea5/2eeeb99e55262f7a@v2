// Prove the process survives an unhandled rejection with the real handlers.
import { createServer } from "http";
import { setupGracefulShutdown } from "/home/runner/workspace/server/port-manager";

const server = createServer((_req, res) => res.end("ok"));
server.listen(0, () => {
  setupGracefulShutdown(server as any, 0);
  console.log("harness up — firing unhandled rejection");
  Promise.reject(new Error("synthetic unhandled rejection"));
  setTimeout(() => {
    console.log("SURVIVED — process still alive 2s after rejection ✅");
    process.exit(0);
  }, 2000);
});
