                        </div>
                        <div style={{ textAlign: 'right', flexShrink: 0 }}>
                          <div className="tp-stack-price">{fmt(showOwing ? (inv.owingCents ?? inv.amountCents) : (inv.amountCents ?? 0))}</div>
