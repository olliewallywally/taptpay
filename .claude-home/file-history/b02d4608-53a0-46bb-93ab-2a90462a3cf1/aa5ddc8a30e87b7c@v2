/* Retail terminal chrome — every selector scoped under `.retail-terminal-view`.
 *
 * Until phase 2 this was an unscoped `<style>` template literal inside
 * features/terminal/retail/RetailTerminalViewCore.jsx.
 * Retail, property and trades each injected one, all three declaring the same
 * global `.tp-*` names, and 24 of those rules carry different values between
 * verticals — `.tp-subbar` scale, `.tp-subbar-ind` z-index, `.tp-amount`
 * weight, `.tp-toast` offset, most of the palette. Whichever <style> tag was
 * later in the DOM won, so which terminal you had visited changed how the next
 * one rendered. That is RC-6 of
 * docs/PLAN-2026-08-17-mobile-responsive-ui.md; scoping is its §5.1 phase 2.
 *
 * The shared @keyframes moved to ../terminal-keyframes.css, imported alongside
 * this file — a descendant selector cannot scope a keyframe, so deduping is the
 * only way to stop those colliding.
 */

.retail-terminal-view.tp-viewport {
  width: 100%; max-width: 430px;
  height: 100vh; height: 100svh; height: 100dvh;
  margin: 0 auto; position: relative; overflow: hidden;
  font-family: 'Outfit', system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
}
.retail-terminal-view .tp-screen { position: absolute; inset: 0; display: flex; flex-direction: column; overflow: hidden; }

/* ── Top banner (success notification) ── */
.retail-terminal-view .tp-top-banner {
  position: absolute; top: 0; left: 0; right: 0; z-index: 55;
  background: linear-gradient(150deg, #040D6D 0%, #072b20 100%);
  border-bottom: 2px solid #1BBF85;
  box-shadow: 0 8px 40px rgba(27,191,133,0.3);
  padding: 52px 22px 20px;
  display: flex; align-items: center; gap: 16px;
  transform: translateY(-100%);
  transition: transform 0.6s cubic-bezier(0.34,1.56,0.64,1);
  pointer-events: none;
}
.retail-terminal-view .tp-top-banner.show { transform: translateY(0); pointer-events: auto; }
.retail-terminal-view .tp-banner-icon {
  width: 44px; height: 44px; border-radius: 50%;
  background: #1BBF85; color: #040D6D;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  animation: tp-bannerPulse 1.4s ease-out 2;
}
.retail-terminal-view .tp-banner-body { display: flex; flex-direction: column; }
.retail-terminal-view .tp-banner-title { font-weight: 700; font-size: 16px; color: #fff; }
.retail-terminal-view .tp-banner-amount { font-weight: 900; font-size: 26px; color: #1BBF85; letter-spacing: -0.5px; margin-top: 2px; }

/* ── Subhead ── */
.retail-terminal-view .tp-subhead { display: flex; justify-content: space-between; align-items: center; padding: 20px 22px 0; }
.retail-terminal-view .tp-subhead-btn {
  width: 44px; height: 44px; border-radius: 999px; border: 2px solid #040D6D;
  display: flex; align-items: center; justify-content: center;
  color: #040D6D; background: none; cursor: pointer; transition: transform 120ms, background 120ms;
}
.retail-terminal-view .tp-subhead-btn:active { transform: scale(0.92); background: rgba(4,13,109,0.06); }

/* ── Amount ── */
.retail-terminal-view .tp-amount { font-family: 'Outfit', system-ui; font-weight: 900; letter-spacing: -0.04em; line-height: 0.95; }

/* ── Pills ── */
.retail-terminal-view .tp-pill {
  display: inline-flex; align-items: center; justify-content: center;
  border-radius: 9999px; padding: 6px 20px;
  font-family: 'Outfit', system-ui; font-weight: 400; font-size: 14px;
  transition: transform 120ms, background 120ms; line-height: 1; cursor: pointer; border: none;
}
.retail-terminal-view .tp-pill:active { transform: scale(0.96); }
.retail-terminal-view .tp-pill.solid { background: #58ABFF; color: #040D6D; }
.retail-terminal-view .tp-pill.outline { background: transparent; color: #58ABFF; box-shadow: inset 0 0 0 0.1px #58ABFF; }

/* ── SubBar ── */
.retail-terminal-view .tp-subbar-wrap { display: flex; justify-content: center; }
.retail-terminal-view .tp-subbar {
  position: relative; display: inline-flex; align-items: center; justify-content: center;
  background: #58ABFF; border-radius: 26px; padding: 5px 11px; gap: 4px;
  border: 1px solid rgba(255,255,255,0.3);
  box-shadow: 0 16px 48px rgba(4,13,109,0.2), 0 4px 12px rgba(4,13,109,0.1), inset 0 1px 0 rgba(255,255,255,0.25);
}
.retail-terminal-view .tp-subbar-ind {
  position: absolute; top: 5px; height: 27px; background: #040D6D; border-radius: 16px;
  box-shadow: 0 4px 16px rgba(4,13,109,0.4); pointer-events: none; z-index: 0; opacity: 0;
  will-change: left, width, opacity;
}
.retail-terminal-view .tp-subbar-ind.on { opacity: 1; }
.retail-terminal-view .tp-subbar-ind.animate {
  transition: left 0.45s cubic-bezier(0.34,1.56,0.64,1), width 0.45s cubic-bezier(0.34,1.56,0.64,1), opacity 0.25s ease;
}
.retail-terminal-view .tp-subbar-btn {
  position: relative; z-index: 1; height: 27px; padding: 0 25px;
  display: flex; align-items: center; justify-content: center; gap: 6px;
  border-radius: 16px; border: none; cursor: pointer; background: transparent; color: rgba(4,13,109,0.55);
  transition: padding 0.45s cubic-bezier(0.34,1.56,0.64,1), color 0.3s ease, transform 0.18s ease;
  -webkit-tap-highlight-color: transparent; flex-shrink: 0;
}
.retail-terminal-view .tp-subbar-btn:active { transform: scale(0.92); }
.retail-terminal-view .tp-subbar-btn.active { background: transparent !important; box-shadow: none !important; color: #58ABFF; }
.retail-terminal-view .tp-subbar.compact .tp-subbar-btn { padding: 0 13px; }
.retail-terminal-view .tp-subbar-label {
  font-family: 'Outfit', system-ui; font-weight: 600; font-size: 12px;
  letter-spacing: 0.4px; color: #58ABFF; white-space: nowrap; animation: tp-labelIn 0.3s ease-out;
}

/* ── Send ── */
.retail-terminal-view .tp-send {
  display: flex; align-items: center; gap: 6px; padding: 4px 14px 4px 4px; border-radius: 26px;
  background: #040D6D; border: none; cursor: pointer; box-shadow: 0 4px 16px rgba(4,13,109,0.25);
  transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
  -webkit-tap-highlight-color: transparent; flex-shrink: 0; height: 37px;
}
.retail-terminal-view .tp-send:active { transform: scale(0.94); }
.retail-terminal-view .tp-send-circle { width: 20px; height: 20px; border-radius: 50%; background: #58ABFF; display: flex; align-items: center; justify-content: center; }
.retail-terminal-view .tp-send-label { font-size: 11px; font-weight: 700; color: #58ABFF; letter-spacing: 0.3px; }

/* ── FAB ── */
.retail-terminal-view .tp-fab {
  width: 70px; height: 70px; border-radius: 999px; background: #58ABFF; color: #040D6D;
  display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 18px rgba(4,13,109,0.25);
  border: none; cursor: pointer; transition: transform 140ms; -webkit-tap-highlight-color: transparent;
}
.retail-terminal-view .tp-fab:active { transform: scale(0.92); }

/* ── Dock ── */
.retail-terminal-view .tp-dock-wrap { position: relative; margin: 0 auto 28px; width: 320px; height: 58px; display: flex; align-items: center; justify-content: center; overflow: visible; }
.retail-terminal-view .tp-dock {
  position: relative; width: 280px; height: 48px; background: #040D6D; border-radius: 24px;
  display: flex; align-items: center; justify-content: space-around; padding: 0 16px; overflow: visible;
}
.retail-terminal-view .tp-dock-ind {
  position: absolute; top: -5px; width: 65px; height: 58px; background: #040D6D; border-radius: 29px; z-index: 0;
  box-shadow: 0 4px 20px rgba(0,0,0,0.45); pointer-events: none; will-change: left;
}
.retail-terminal-view .tp-dock-ind.animate { transition: left 0.45s cubic-bezier(0.34,1.56,0.64,1); }
.retail-terminal-view .tp-dock-btn {
  position: relative; z-index: 1; background: none; border: none; padding: 8px;
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  transition: transform 0.25s ease; -webkit-tap-highlight-color: transparent;
}
.retail-terminal-view .tp-dock-btn:active { transform: scale(0.95); }
.retail-terminal-view .tp-dock-btn.active { transform: scale(1.15); }

/* ── Stack ── */
.retail-terminal-view .tp-stack-hdr { display: flex; justify-content: space-between; align-items: center; padding: 0 4px; margin-bottom: 12px; }
.retail-terminal-view .tp-stack-title { font-weight: 700; font-size: 14px; color: #040D6D; letter-spacing: -0.2px; }
.retail-terminal-view .tp-stack-card { border-radius: 14px; background: #fff; overflow: hidden; box-shadow: 0 2px 12px rgba(4,13,109,0.06); border: 1px solid rgba(4,13,109,0.04); }
.retail-terminal-view .tp-stack-row { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; animation: tp-stackIn 0.38s cubic-bezier(0.34,1.56,0.64,1) both; }
.retail-terminal-view .tp-stack-row + .tp-stack-row { border-top: 1px solid rgba(4,13,109,0.05); }
.retail-terminal-view .tp-stack-row.holdable { cursor: pointer; background: rgba(255,159,67,0.04); }
.retail-terminal-view .tp-stack-row.holdable:active { background: rgba(255,159,67,0.1); }
.retail-terminal-view .tp-stack-name { font-weight: 600; font-size: 14px; color: #040D6D; margin-bottom: 1px; }
.retail-terminal-view .tp-stack-meta { display: flex; align-items: center; gap: 5px; }
.retail-terminal-view .tp-stack-status { font-weight: 500; font-size: 11px; color: rgba(4,13,109,0.35); }
.retail-terminal-view .tp-stack-price { font-weight: 700; font-size: 15px; color: #040D6D; letter-spacing: -0.3px; }
.retail-terminal-view .tp-stack-empty { padding: 14px 16px; font-size: 13px; color: rgba(4,13,109,0.4); text-align: center; }
.retail-terminal-view .tp-hold-hint { font-size: 10px; font-weight: 600; color: #FF9F43; }
.retail-terminal-view .tp-dot { width: 5px; height: 5px; border-radius: 50%; animation: tp-pulse 2s ease-in-out infinite; }
.retail-terminal-view .tp-dot.awaiting { background: #58ABFF; }
.retail-terminal-view .tp-dot.payment-sent { background: #58ABFF; }
.retail-terminal-view .tp-dot.paid { background: #1BBF85; animation: none; opacity: 1; }
.retail-terminal-view .tp-dot.declined { background: #FF5B5B; animation: none; opacity: 1; }
.retail-terminal-view .tp-dot.hold { background: #FF9F43; }
.retail-terminal-view .tp-stack-split { display: flex; flex-direction: column; gap: 5px; margin-top: 5px; padding: 6px 8px; background: rgba(4,13,109,0.04); border-radius: 8px; border-left: 3px solid #58ABFF; }
.retail-terminal-view .tp-stack-split-label { font-size: 9px; font-weight: 800; color: #58ABFF; letter-spacing: 0.6px; text-transform: uppercase; }
.retail-terminal-view .tp-stack-split-bars { display: flex; gap: 4px; align-items: center; }
.retail-terminal-view .tp-split-bar { height: 7px; flex: 1; border-radius: 4px; background: rgba(4,13,109,0.1); }
.retail-terminal-view .tp-split-bar.filled { background: #1BBF85; }
.retail-terminal-view .tp-stack-split-dots { display: flex; gap: 5px; align-items: center; }
.retail-terminal-view .tp-split-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(4,13,109,0.12); border: 1.5px solid rgba(4,13,109,0.15); }
.retail-terminal-view .tp-split-dot.filled { background: #1BBF85; border-color: #1BBF85; }
.retail-terminal-view .tp-stack-split-count { font-size: 12px; font-weight: 700; color: #040D6D; }

/* ── Stock tiles ── */
.retail-terminal-view .tp-stock-tile {
  aspect-ratio: 1/1; background: #F4F4F4; border-radius: 22px; border: none; cursor: pointer;
  transition: transform 120ms, box-shadow 120ms; position: relative;
}
.retail-terminal-view .tp-stock-tile:active { transform: scale(0.95); }
.retail-terminal-view .tp-stock-tile.selected { box-shadow: inset 0 0 0 3px #58ABFF; }
.retail-terminal-view .tp-stock-qty {
  position: absolute; top: 7px; right: 7px;
  min-width: 20px; height: 20px; border-radius: 999px;
  background: #040D6D; color: #58ABFF;
  font-size: 11px; font-weight: 800; display: flex; align-items: center; justify-content: center;
  padding: 0 5px;
}

/* ── Fields ── */
.retail-terminal-view .tp-field {
  width: 100%; padding: 18px 24px; border-radius: 999px;
  background: #F4F4F4; border: none; color: #040D6D;
  font-family: 'Outfit', system-ui; font-weight: 500; font-size: 17px;
  letter-spacing: -0.01em; outline: none; box-sizing: border-box;
}
.retail-terminal-view .tp-field::placeholder { color: rgba(4,13,109,0.35); }

/* ── CTA ── */
.retail-terminal-view .tp-cta {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 14px 36px; border-radius: 999px; background: #58ABFF; color: #040D6D;
  font-family: 'Outfit', system-ui; font-weight: 600; font-size: 15px;
  transition: transform 120ms, opacity 120ms; white-space: nowrap; border: none; cursor: pointer; box-sizing: border-box;
}
.retail-terminal-view .tp-cta:active { transform: scale(0.96); opacity: 0.92; }

/* ── Stepper ── */
.retail-terminal-view .tp-stepper {
  width: 44px; height: 44px; border-radius: 999px; background: #58ABFF; color: #040D6D;
  display: flex; align-items: center; justify-content: center;
  font-size: 22px; font-weight: 700; border: none; cursor: pointer; transition: transform 100ms;
}
.retail-terminal-view .tp-stepper:active { transform: scale(0.92); }

/* ── Keypad ── */
/* Phase C of docs/SPEC-2026-08-20-dock-implementation.md §5: --kp-size is
   declared on .tp-panel-body (terminal-tokens.css), capped at --kp-max (76px)
   and derived from the panel's own realised height so four rows fit without
   scrolling at every viewport in the matrix. Font-size rides the same ratio
   (30/76) so the digits stay proportional as the key shrinks. */
.retail-terminal-view .tp-kp {
  width: var(--kp-size, 76px); height: var(--kp-size, 76px); border-radius: 999px;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Outfit', system-ui; font-weight: 700; font-size: calc(var(--kp-size, 76px) * 0.3947);
  transition: transform 100ms, background 100ms; background: #58ABFF; color: #fff; border: none; cursor: pointer;
}
.retail-terminal-view .tp-kp:active { transform: scale(0.92); }
.retail-terminal-view .tp-kp.outline { background: transparent; color: #58ABFF; box-shadow: inset 0 0 0 2px #58ABFF; }
.retail-terminal-view .tp-kp.outline:active { background: rgba(88,171,255,0.12); }

/* ── QR ── */
.retail-terminal-view .tp-qr-card { width: 220px; height: 220px; border-radius: 28px; background: #040D6D; box-shadow: inset 0 0 0 4px #58ABFF; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.retail-terminal-view .tp-qr-expand {
  position: absolute; bottom: 10px; right: 10px; width: 30px; height: 30px; border-radius: 50%;
  background: rgba(4,13,109,0.55); border: 1.5px solid #58ABFF; color: #58ABFF;
  display: flex; align-items: center; justify-content: center; cursor: pointer; transition: transform 0.18s, background 0.18s;
}
.retail-terminal-view .tp-qr-expand:active { transform: scale(0.88); background: rgba(88,171,255,0.25); }
.retail-terminal-view .tp-qr-modal {
  position: absolute; inset: 0; z-index: 50;
  background: rgba(4,13,109,0.82); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
  display: flex; align-items: center; justify-content: center; animation: tp-fadeIn 0.22s ease both;
}
.retail-terminal-view .tp-qr-modal-inner {
  position: relative; background: #040D6D; border-radius: 36px;
  padding: 36px 36px 28px; border: 3px solid #58ABFF;
  box-shadow: 0 28px 80px rgba(4,13,109,0.7);
  animation: tp-scaleIn 0.4s cubic-bezier(0.34,1.56,0.64,1) both;
  display: flex; flex-direction: column; align-items: center;
}
.retail-terminal-view .tp-qr-modal-close {
  position: absolute; top: 14px; right: 14px; width: 32px; height: 32px; border-radius: 50%;
  border: 1.5px solid rgba(88,171,255,0.5); color: #58ABFF; background: none; cursor: pointer;
  display: flex; align-items: center; justify-content: center; transition: background 0.15s, transform 0.15s;
}
.retail-terminal-view .tp-qr-modal-close:active { background: rgba(88,171,255,0.15); transform: scale(0.9); }

/* ── Share buttons ── */
.retail-terminal-view .tp-share-btn {
  background: none; border: none; cursor: pointer; padding: 8px;
  display: flex; align-items: center; justify-content: center;
  transition: transform 0.15s, opacity 0.15s; border-radius: 50%; -webkit-tap-highlight-color: transparent;
}
.retail-terminal-view .tp-share-btn:active { transform: scale(0.85); opacity: 0.65; }

/* ── Success check ── */
.retail-terminal-view .tp-success-check { width: 92px; height: 92px; border-radius: 999px; background: #58ABFF; display: flex; align-items: center; justify-content: center; color: #040D6D; }
.retail-terminal-view .tp-pulse { animation: tp-pulseDot 1800ms ease-in-out infinite; }

/* ── Scroll ── */
.retail-terminal-view .tp-thin-scroll { scrollbar-width: thin; scrollbar-color: rgba(88,171,255,0) transparent; transition: scrollbar-color 350ms; }
.retail-terminal-view .tp-thin-scroll.scrolling { scrollbar-color: #58ABFF transparent; }
.retail-terminal-view .tp-thin-scroll::-webkit-scrollbar { width: 3px; }
.retail-terminal-view .tp-thin-scroll::-webkit-scrollbar-thumb { background-color: rgba(88,171,255,0); border-radius: 999px; }
.retail-terminal-view .tp-thin-scroll.scrolling::-webkit-scrollbar-thumb { background-color: #58ABFF; }
/* Stack scroll — navy thumb, no track, no arrows */
.retail-terminal-view .tp-stack-scroll { scrollbar-width: thin; scrollbar-color: #040D6D transparent; }
.retail-terminal-view .tp-stack-scroll::-webkit-scrollbar { width: 4px; background: transparent; }
.retail-terminal-view .tp-stack-scroll::-webkit-scrollbar-track { background: transparent; }
.retail-terminal-view .tp-stack-scroll::-webkit-scrollbar-thumb { background: #040D6D; border-radius: 999px; }
.retail-terminal-view .tp-stack-scroll::-webkit-scrollbar-button { display: none; height: 0; width: 0; }

/* ── Toast ── */
.retail-terminal-view .tp-toast {
  position: absolute; left: 50%; transform: translateX(-50%); bottom: 28px;
  background: #040D6D; color: #F4F4F4; padding: 12px 22px; border-radius: 999px;
  font-size: 14px; font-weight: 500; opacity: 0; pointer-events: none;
  transition: opacity 200ms, transform 200ms; z-index: 60;
}
.retail-terminal-view .tp-toast.show { opacity: 1; transform: translateX(-50%) translateY(-4px); }

/* ── Conveyor ── */
.retail-terminal-view .tp-layer { position: absolute; inset: 0; display: flex; flex-direction: column; overflow: hidden; will-change: transform; z-index: 0; }
.retail-terminal-view .tp-layer.leaving.up { animation: tp-outUp   0.48s cubic-bezier(0.4,0,0.2,1) both; z-index: 1; }
.retail-terminal-view .tp-layer.leaving.down { animation: tp-outDown 0.48s cubic-bezier(0.4,0,0.2,1) both; z-index: 1; }
.retail-terminal-view .tp-layer.entering.up { animation: tp-inUp   0.48s cubic-bezier(0.16,1,0.3,1) both; }
.retail-terminal-view .tp-layer.entering.down { animation: tp-inDown 0.48s cubic-bezier(0.16,1,0.3,1) both; }
.retail-terminal-view .tp-layer.leaving.morph { animation: tp-outMorph 0.22s ease-out both; z-index: 1; }

/* ── popIn ── */
.retail-terminal-view .stagger { transition: height 0.55s cubic-bezier(0.34,1.56,0.64,1); }
.retail-terminal-view .stagger > * { animation: tp-popIn 0.4s cubic-bezier(0.34,1.56,0.64,1) both; }
.retail-terminal-view .stagger > *:nth-child(1) { animation-delay: 0s; }
.retail-terminal-view .stagger > *:nth-child(2) { animation-delay: 0.06s; }
.retail-terminal-view .stagger > *:nth-child(3) { animation-delay: 0.12s; }
.retail-terminal-view .stagger > *:nth-child(4) { animation-delay: 0.18s; }
.retail-terminal-view .stagger > *:nth-child(5) { animation-delay: 0.24s; }
.retail-terminal-view .stagger > *:nth-child(6) { animation-delay: 0.30s; }

/* ── Overlay ── */
.retail-terminal-view .tp-overlay { position: absolute; inset: 0; pointer-events: none; z-index: 30; }
.retail-terminal-view .tp-overlay > * { pointer-events: auto; }
.retail-terminal-view .tp-pfab {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  transition: opacity 240ms cubic-bezier(0,0,0.2,1), transform 360ms cubic-bezier(0.34,1.56,0.64,1);
  will-change: opacity, transform;
}
.retail-terminal-view .tp-pfab.hide { opacity: 0; transform: translate(-50%, -50%) translateY(8px) scale(0.7); pointer-events: none; }
.retail-terminal-view .tp-pfab.show { opacity: 1; }
.retail-terminal-view .tp-psubbar {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, 67px);
  display: flex; align-items: center; gap: 8px;
  transition: opacity 220ms cubic-bezier(0,0,0.2,1), transform 300ms cubic-bezier(0.4,0,0.2,1);
  will-change: opacity, transform;
  height: 37px;
}
.retail-terminal-view .tp-psubbar.hide { opacity: 0; transform: translate(-50%, 67px) scale(0.92); pointer-events: none; }
.retail-terminal-view .tp-psubbar.show { opacity: 1; }
.retail-terminal-view .tp-psubbar.feature { transform: translate(-50%, calc(-100% - 20px)); }
.retail-terminal-view .tp-send-slot {
  display: flex; align-items: center; overflow: hidden; max-width: 0; opacity: 0;
  transition: max-width 420ms cubic-bezier(0.34,1.56,0.64,1), opacity 280ms ease 80ms;
  height: 37px;
}
.retail-terminal-view .tp-send-slot.show { max-width: 143px; opacity: 1; }
.retail-terminal-view .tp-pdock {
  position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: center;
  transition: opacity 280ms cubic-bezier(0,0,0.2,1), transform 360ms cubic-bezier(0.34,1.56,0.64,1);
  will-change: opacity, transform;
}
.retail-terminal-view .tp-pdock.hide { opacity: 0; transform: translateY(24px); pointer-events: none; }
